APP_NAME="Universal App API"
ENVIRONMENT=development
SECRET_KEY="change-this-to-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL="sqlite:///./universal_app.db"

# Change local service host/ports here, then run: bash start_service.sh.
# For public/LAN access, keep *_HOST as 0.0.0.0.
# Put the public IP/domain in API_BASE_URL and BACKEND_CORS_ORIGINS instead.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Optional. Leave empty for local-only use.
# If BACKEND_HOST=0.0.0.0, set this to the real URL clients can reach,
# for example http://192.168.1.20:8000 or https://api.example.com.
API_BASE_URL=

BACKEND_CORS_ORIGINS='["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]'
BACKEND_CORS_ORIGIN_REGEX='^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0)(:\d+)?$'
