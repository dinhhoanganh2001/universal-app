APP_NAME="Universal App API"
ENVIRONMENT=development
SECRET_KEY="change-this-to-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
DATABASE_URL="sqlite:///./universal_app.db"

# Change local service host/ports in the root .env file when using ../start_service.sh.
# For public/LAN access, keep *_HOST as 0.0.0.0.
# Put the public IP/domain in API_BASE_URL and BACKEND_CORS_ORIGINS instead.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Optional. Leave empty when frontend and backend use the same hostname
# and the backend is reachable on BACKEND_PORT from the browser.
# If frontend/backend use different hostnames, protocols, or a reverse proxy,
# set this to the real API URL clients can reach.
API_BASE_URL=

# For deployment, include the exact frontend origin users open in the browser.
BACKEND_CORS_ORIGINS='["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]'
BACKEND_CORS_ORIGIN_REGEX='^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(1[6-9]|2[0-9]|3[01])(?:\.\d{1,3}){2})(:\d+)?$'
